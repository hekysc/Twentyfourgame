{
  "bsonType": "object",
  "required": [],
  "permission": {
    "read": "auth.uid != null",
    "create": true,
    "update": "doc.auth.uid == auth.uid",
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "openid": {
      "bsonType": "string",
      "description": "微信小程序用户的唯一标识"
    },
    "unionid": {
      "bsonType": "string",
      "description": "微信开放平台唯一标识（可选）"
    },
    "device_id": {
      "bsonType": "string",
      "description": "App 端游客或设备登录的唯一标识"
    },
    "phone": {
      "bsonType": "string",
      "description": "手机号（如果使用手机号登录）"
    },
    "nickname": {
      "bsonType": "string",
      "description": "用户昵称",
      "defaultValue": "新用户"
    },
    "avatar_url": {
      "bsonType": "string",
      "description": "用户头像 URL",
      "defaultValue": "default_avatar.png"
    },
    "gender": {
      "bsonType": "int",
      "description": "性别 0:未知 1:男 2:女",
      "defaultValue": 0
    },
    "platforms": {
      "bsonType": "array",
      "description": "记录该用户在哪些平台登录过",
      "defaultValue": []
    },
    "created_at": {
      "bsonType": "timestamp",
      "description": "注册时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    },
    "last_login_at": {
      "bsonType": "timestamp",
      "description": "最后登录时间"
    },
    "score": {
      "bsonType": "int",
      "description": "业务字段：积分",
      "defaultValue": 0
    },
    "level": {
      "bsonType": "int",
      "description": "业务字段：等级",
      "defaultValue": 1
    }
  }
}
